# Copia questo file in "src/env.properties" e riempi i valori.
# In locale viene caricato da application.properties (spring.config.import).
# In produzione (Koyeb) NON serve questo file: imposta le stesse chiavi come
# variabili d'ambiente del servizio.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/capstone
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Segreto per firmare i JWT: stringa lunga e casuale (es. base64 di 48+ byte)
JWT_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale

# Mail non usata: lascia un valore qualsiasi così la property si risolve
MAIL_PASSWORD=unused
